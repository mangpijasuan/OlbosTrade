# Environment — NEVER commit real secrets
.env
.env.local
.env.production

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
*.egg-info/
dist/
build/
.venv/
venv/

# Vendored IBKR Client Portal gateway — keep its dist/ and build/ jars
# (overrides the generic Python dist/ build/ ignores above)
!deploy/clientportal/dist/
!deploy/clientportal/dist/**
!deploy/clientportal/build/
!deploy/clientportal/build/**

# Node
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/

# Docker volumes / local data
postgres_data/
redis_data/

# IDE
.DS_Store
.idea/
.vscode/
*.swp

# Logs
*.log
logs/

# Alembic
alembic/versions/*.pyc
