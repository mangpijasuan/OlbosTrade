# ──────────────────────────────────────────────
# Broker
# ──────────────────────────────────────────────
BROKER=ibkr
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
TRADIER_API_KEY=
TRADIER_SANDBOX=true

# ──────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────
POSTGRES_USER=options_user
POSTGRES_PASSWORD=options_pass
POSTGRES_DB=options_db
DATABASE_URL=postgresql+asyncpg://options_user:options_pass@postgres:5432/options_db
REDIS_URL=redis://redis:6379

# ──────────────────────────────────────────────
# Trading Rules
# ──────────────────────────────────────────────
STARTING_CAPITAL=25000
MAX_DAILY_LOSS_PCT=0.02
MAX_WEEKLY_LOSS_PCT=0.05
MAX_MONTHLY_LOSS_PCT=0.10
MAX_CONCURRENT_POSITIONS=5
MAX_TRADES_PER_DAY=3
MAX_CONSECUTIVE_LOSSES=3
COOLING_OFF_HOURS=24
CAPITAL_PRESERVATION_THRESHOLD=0.85

# ──────────────────────────────────────────────
# AI Signal Scorer
# ──────────────────────────────────────────────
SIGNAL_SCORE_THRESHOLD=0.65
SIGNAL_SCORE_PRESERVATION_MODE=0.80
MODEL_PATH=ml/model_registry/signal_scorer_v1.pkl
RETRAIN_SCHEDULE=monthly

# ──────────────────────────────────────────────
# Alerts
# ──────────────────────────────────────────────
SENDGRID_API_KEY=
ALERT_EMAIL=
LOG_LEVEL=INFO
