# Copy to backend/.env.prod on the server:
#   cp deploy/hetzner/.env.example backend/.env.prod
#
# Generate secrets:
#   python3 -c "import secrets; print(secrets.token_hex(32))"

# ── Database ───────────────────────────────────────────────────────
# Must match OLBOSQUANT_DB_PASSWORD in docker-compose.hetzner.yml
OLBOSQUANT_DB_PASSWORD=change-me-long-random-string

# The DATABASE_URL and REDIS_URL are injected by docker-compose.hetzner.yml
# (pointing to olbosquant-db and olbosquant-redis containers)
# Leave these blank here — docker-compose overrides them.
DATABASE_URL=
REDIS_URL=

# ── App security ───────────────────────────────────────────────────
OLBOS_API_KEY=

# ── Trading (paper only — do NOT change BROKER to live) ───────────
BROKER=ibkr
# Docker network hostname when ibkr-gateway runs on the same host (see README)
IBKR_HOST=ibkr-gateway
# gnzsnz/ib-gateway socat paper port inside the container (not 4002)
IBKR_PORT=4004
IBKR_CLIENT_ID=2
IBKR_TRADING_MODE=paper
STARTING_CAPITAL=25000.0

# ── Risk defaults ──────────────────────────────────────────────────
MAX_DAILY_LOSS_PCT=0.02
MAX_WEEKLY_LOSS_PCT=0.05
MAX_MONTHLY_LOSS_PCT=0.10
MAX_CONSECUTIVE_LOSSES=4
MAX_TRADES_PER_DAY=10
CAPITAL_PRESERVATION_THRESHOLD=0.85

# ── Optional external services ─────────────────────────────────────
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
GEMINI_API_KEY=
SENDGRID_API_KEY=

# ── Logging ────────────────────────────────────────────────────────
LOG_LEVEL=INFO
APP_ENV=production
