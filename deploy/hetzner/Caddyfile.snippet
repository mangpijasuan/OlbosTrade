# ── Add this block to the Caddyfile bind-mounted into the sibling Caddy
# container (commonly /root/OlbosTerminal/docker/Caddyfile, but verify with
# `docker inspect <caddy-container> --format '{{range .Mounts}}...'` —
# this path is NOT guaranteed to match on every server).
# It adds OlbosTrade as a second site on the same Caddy instance.
# Replace trading.yourdomain.com with your actual subdomain.
#
# Everything routes through the frontend container's own nginx (port 3000 —
# see frontend/docker-entrypoint.sh), which already does the real routing:
# it proxies /api, /docs, /openapi.json, /ws to olbostrade-backend itself
# AND applies DASH_USER/DASH_PASS Basic Auth to the whole server block when
# those are set. Do NOT special-case /api or /ws here to reverse_proxy the
# backend directly — that bypasses nginx's auth_basic block entirely, so
# DASH_USER/DASH_PASS silently stops protecting the API even though it's
# documented as covering "the whole app". A prior version of this snippet
# did exactly that.

trading.yourdomain.com {
	reverse_proxy olbostrade-frontend:3000
}
