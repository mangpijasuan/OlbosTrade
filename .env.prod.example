# ═══════════════════════════════════════════════════════════════════
# OlbosQuant — Production Environment Variables
# DigitalOcean Deployment
#
# SETUP:
#   1. Copy this file: cp .env.prod.example .env.prod
#   2. Fill in every value marked [REQUIRED]
#   3. Never commit .env.prod to git
# ═══════════════════════════════════════════════════════════════════

# ── DigitalOcean Container Registry ──────────────────────────────
DO_REGISTRY_NAME=olbosquant        # Your DO registry name
IMAGE_TAG=latest                   # Or a specific git SHA for pinned deploys

# ── Broker ───────────────────────────────────────────────────────
BROKER=ibkr                        # ibkr (ib_insync) | ibkr_cp (Client Portal) | alpaca
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
# Tradier is NOT a broker here (no order routing) — this key only enables the
# optional Tradier live-quote feed used by paper_trader. Leave blank to use IBKR.
TRADIER_API_KEY=                   # optional: developer.tradier.com (quotes only)
TRADIER_SANDBOX=true

# ── IBKR Client Portal Web API (used when BROKER=ibkr_cp) ─────────
# Headless gateway runs on the droplet (compose service ib-gateway-cp).
# Read-only today (orders disabled); authenticate once via SSH tunnel + browser.
# See deploy/clientportal/README.md.
CP_GATEWAY_URL=https://ib-gateway-cp:5000
CP_GATEWAY_VERIFY_SSL=false
CP_ACCOUNT_ID=
CP_TICKLE_INTERVAL_S=60

# ── Database (DO Managed PostgreSQL) ─────────────────────────────
# Get this from: DO Console → Databases → your cluster → Connection string
DATABASE_URL=postgresql+asyncpg://doadmin:YOURPASSWORD@db-postgresql-nyc3-XXXXX.db.ondigitalocean.com:25060/defaultdb?ssl=require
# [REQUIRED] — paste exact connection string from DO console

# ── Redis (DO Managed Redis) ──────────────────────────────────────
# Get this from: DO Console → Databases → your Redis cluster → Connection string
REDIS_URL=rediss://default:YOURPASSWORD@db-redis-nyc3-XXXXX.db.ondigitalocean.com:25061
# [REQUIRED] — note: rediss:// (with SSL) for managed Redis

# ── Trading Rules ─────────────────────────────────────────────────
STARTING_CAPITAL=25000
MAX_DAILY_LOSS_PCT=0.02
MAX_WEEKLY_LOSS_PCT=0.05
MAX_MONTHLY_LOSS_PCT=0.10
MAX_CONCURRENT_POSITIONS=5
MAX_TRADES_PER_DAY=3
MAX_CONSECUTIVE_LOSSES=3
COOLING_OFF_HOURS=24
CAPITAL_PRESERVATION_THRESHOLD=0.85

# ── AI Signal Scorer ──────────────────────────────────────────────
SIGNAL_SCORE_THRESHOLD=0.65
SIGNAL_SCORE_PRESERVATION_MODE=0.80
MODEL_PATH=/app/ml/model_registry/signal_scorer_v1.pkl
RETRAIN_SCHEDULE=monthly

# ── Alerts (SendGrid) ────────────────────────────────────────────
SENDGRID_API_KEY=                  # [REQUIRED] for trade alerts + guardrail emails
ALERT_EMAIL=                       # [REQUIRED] your email address

# ── Security ──────────────────────────────────────────────────────
SECRET_KEY=                        # [REQUIRED] generate: openssl rand -hex 32
LOG_LEVEL=INFO
