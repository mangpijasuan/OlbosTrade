# ──────────────────────────────────────────────
# Active broker — switch between "ibkr" and "alpaca"
# ──────────────────────────────────────────────
BROKER=ibkr

# ── IBKR (used when BROKER=ibkr) ──────────────
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
IBKR_TRADING_MODE=paper
IBKR_USERNAME=
IBKR_PASSWORD=
VNC_PASSWORD=localdev

# ── Alpaca (used when BROKER=alpaca) ──────────
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── Legacy Tradier ─────────────────────────────
TRADIER_API_KEY=
TRADIER_SANDBOX=true

# ──────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────
POSTGRES_USER=options_user
POSTGRES_PASSWORD=options_pass
POSTGRES_DB=options_db
DATABASE_URL=postgresql+asyncpg://options_user:options_pass@postgres:5432/options_db
REDIS_URL=redis://redis:6379

# ──────────────────────────────────────────────
# Trading Rules
# ──────────────────────────────────────────────
STARTING_CAPITAL=25000
MAX_DAILY_LOSS_PCT=0.02
MAX_WEEKLY_LOSS_PCT=0.05
MAX_MONTHLY_LOSS_PCT=0.10
MAX_CONCURRENT_POSITIONS=5
MAX_TRADES_PER_DAY=6
MAX_CONSECUTIVE_LOSSES=3
COOLING_OFF_HOURS=24
CAPITAL_PRESERVATION_THRESHOLD=0.85
MAX_EQUITY_POSITIONS=5
MAX_OPTIONS_POSITIONS=5

# ──────────────────────────────────────────────
# Equity signal settings
# ──────────────────────────────────────────────
EQUITY_WATCHLIST=AAPL,NVDA,MSFT,META,AMZN,GOOGL,AMD,TSLA,SPY,QQQ,JPM,V,MA
EQUITY_SIGNAL_INTERVAL_MINUTES=15
EQUITY_MIN_CONFIDENCE=0.62
EQUITY_MIN_RISK_REWARD=1.80
EARNINGS_GATE_DAYS=3

# ──────────────────────────────────────────────
# AI Signal Scorer
# ──────────────────────────────────────────────
SIGNAL_SCORE_THRESHOLD=0.65
SIGNAL_SCORE_PRESERVATION_MODE=0.80
MODEL_PATH=ml/model_registry/signal_scorer_v1.pkl
RETRAIN_SCHEDULE=monthly

# ──────────────────────────────────────────────
# Options Intelligence — Options Flow module
# ──────────────────────────────────────────────
# Live streaming requires an IBKR LIVE OPRA market-data subscription
# (reqTickByTickData does NOT work on delayed data). Default OFF; the module
# wires up cleanly and activates the moment a live feed is available.
OPTIONS_FLOW_ENABLED=false
# Emit synthetic ticks to exercise the full pipeline without a live feed.
OPTIONS_FLOW_DEMO_MODE=false
OPTIONS_FLOW_WATCHLIST=SPY,QQQ,IWM,AAPL,TSLA,NVDA
OPTIONS_FLOW_MAX_DTE=60
OPTIONS_FLOW_MAX_CONTRACTS=40
OPTIONS_FLOW_SWEEP_WINDOW_MS=500
OPTIONS_FLOW_BLOCK_MIN_SIZE=500
OPTIONS_FLOW_LARGE_SWEEP_PREMIUM=500000
OPTIONS_FLOW_CHANNEL=options_flow_live
OPTIONS_FLOW_RETENTION_DAYS=90
OPTIONS_FLOW_ARCHIVE_DIR=/data/archive

# ──────────────────────────────────────────────
# Alerts
# ──────────────────────────────────────────────
SENDGRID_API_KEY=
ALERT_EMAIL=
LOG_LEVEL=INFO
