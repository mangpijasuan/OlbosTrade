# Copy to backend/.env.prod on the server:
#   cp deploy/hetzner/.env.example backend/.env.prod
#
# Generate secrets:
#   python3 -c "import secrets; print(secrets.token_hex(32))"

# ── Database ───────────────────────────────────────────────────────
# Must match OLBOSTRADE_DB_PASSWORD in docker-compose.hetzner.yml
OLBOSTRADE_DB_PASSWORD=change-me-long-random-string

# The DATABASE_URL and REDIS_URL are injected by docker-compose.hetzner.yml
# (pointing to olbostrade-db and olbostrade-redis containers)
# Leave these blank here — docker-compose overrides them.
DATABASE_URL=
REDIS_URL=

# ── App security ───────────────────────────────────────────────────
OLBOS_API_KEY=

# ── Trading (paper only — do NOT change BROKER to live) ───────────
BROKER=ibkr
# Docker network hostname when ibkr-gateway runs on the same host (see README)
IBKR_HOST=ibkr-gateway
# gnzsnz/ib-gateway socat paper port inside the container (not 4002)
IBKR_PORT=4004
IBKR_CLIENT_ID=2
IBKR_TRADING_MODE=paper
STARTING_CAPITAL=25000.0

# ── Risk defaults ──────────────────────────────────────────────────
MAX_DAILY_LOSS_PCT=0.02
MAX_WEEKLY_LOSS_PCT=0.05
MAX_MONTHLY_LOSS_PCT=0.10
MAX_CONSECUTIVE_LOSSES=4
MAX_TRADES_PER_DAY=10
CAPITAL_PRESERVATION_THRESHOLD=0.85

# ── Optional external services ─────────────────────────────────────
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
GEMINI_API_KEY=
SENDGRID_API_KEY=

# ── Dashboard access control (HTTP Basic Auth over the whole app) ──
# Set BOTH to require a username/password before anyone can reach the
# dashboard or API. Strongly recommended when exposing the app by public IP.
# Leave blank to serve open (local/dev only).
DASH_USER=
DASH_PASS=

# ── Database backups (deploy/hetzner/backup_db.sh) ─────────────────
# Local dumps always written to BACKUP_DIR (default /opt/olbostrade-backups),
# pruned after BACKUP_RETENTION_DAYS (default 14). For OFF-SITE copies set ONE:
#   BACKUP_RCLONE_REMOTE=myremote:olbostrade-backups   # rclone (S3/B2/GDrive…)
#   BACKUP_SCP_TARGET=user@host:/path/olbostrade-backups
BACKUP_DIR=
BACKUP_RETENTION_DAYS=
BACKUP_RCLONE_REMOTE=
BACKUP_SCP_TARGET=

# ── Execution test mode (PAPER validation) ─────────────────────────
# true = bypass the quality/frequency guards so the system actually places
# trades, to verify the pipeline end-to-end. Hard safety rails still apply
# (kill switch, paper/account guard, market hours, margin, sizing). NEVER leave
# on for a real run. Pair with MARKET_HOURS_ONLY=false to attempt off-hours.
EXECUTION_TEST_MODE=false

# ── Logging ────────────────────────────────────────────────────────
LOG_LEVEL=INFO
APP_ENV=production
