# ──────────────────────────────────────────────
# Active broker (IBKR only)
# ──────────────────────────────────────────────
BROKER=ibkr

# ── IBKR ──────────────────────────────────────
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
IBKR_TRADING_MODE=paper
IBKR_USERNAME=
IBKR_PASSWORD=
VNC_PASSWORD=localdev

# ──────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────
POSTGRES_USER=options_user
POSTGRES_PASSWORD=options_pass
POSTGRES_DB=options_db
DATABASE_URL=postgresql+asyncpg://options_user:options_pass@postgres:5432/options_db

# ──────────────────────────────────────────────
# Trading Rules
# ──────────────────────────────────────────────
STARTING_CAPITAL=25000
MAX_DAILY_LOSS_PCT=0.02
MAX_WEEKLY_LOSS_PCT=0.05
MAX_MONTHLY_LOSS_PCT=0.10
MAX_CONCURRENT_POSITIONS=5
MAX_TRADES_PER_DAY=6
MAX_CONSECUTIVE_LOSSES=3
COOLING_OFF_HOURS=24
CAPITAL_PRESERVATION_THRESHOLD=0.85
MAX_EQUITY_POSITIONS=5
MAX_OPTIONS_POSITIONS=5

# Auto-close any open equity position once unrealized profit crosses this
# many dollars. An exit rule (fires regardless of execution mode, like the
# bracket's own stop-loss/take-profit). 0 disables the check. Options
# positions are not affected (closing a 2-leg spread isn't built yet).
AUTO_CLOSE_PROFIT_THRESHOLD=500
AUTO_CLOSE_CHECK_INTERVAL_MINUTES=5

# Only submit orders during US regular trading hours (09:30–16:00 ET, Mon–Fri,
# excluding holidays). The app still runs 24/7 and resumes trading automatically
# at the open. Set to false to allow order attempts at any time (not recommended).
MARKET_HOURS_ONLY=true

# ──────────────────────────────────────────────
# Equity signal settings
# ──────────────────────────────────────────────
EQUITY_WATCHLIST=AAPL,NVDA,MSFT,META,AMZN,GOOGL,AMD,TSLA,SPY,QQQ,JPM,V,MA
EQUITY_SIGNAL_INTERVAL_MINUTES=15
# Symbols scanned per background-scan tick. 0 = whole watchlist every cycle
# (recommended — more candidates evaluated, same confidence bar). Set to a
# smaller number (e.g. 5) to go back to the old rotating-window behavior.
EQUITY_SCAN_WINDOW_SIZE=0
EQUITY_MIN_CONFIDENCE=0.62
EQUITY_MIN_RISK_REWARD=1.80
EARNINGS_GATE_DAYS=3

# ──────────────────────────────────────────────
# AI Signal Scorer
# ──────────────────────────────────────────────
SIGNAL_SCORE_THRESHOLD=0.65
SIGNAL_SCORE_PRESERVATION_MODE=0.80
MODEL_PATH=ml/model_registry/signal_scorer_v1.pkl
RETRAIN_SCHEDULE=monthly

# ──────────────────────────────────────────────
# Security
# ──────────────────────────────────────────────
# When set, trade-desk mutate routes (approve, mode, manual-trade, scan submit)
# require header X-Api-Key. Enter the same value in Risk → Operator API Key
# (sessionStorage only — never commit this value into frontend source).
SECRET_KEY=

# Required to reset an engaged kill switch. Operator types it in the UI;
# never embed this string in the frontend bundle.
KILL_SWITCH_RESET_CODE=

# Step 8 portfolio gate on _execute_signal (concentration / max positions / heat).
# Set false to roll back without redeploying code. Greeks caps stay off unless
# EXECUTION_ENFORCE_PORTFOLIO_GREEKS=true (not recommended — miscalibrated).
EXECUTION_PORTFOLIO_GATE=true
EXECUTION_ENFORCE_PORTFOLIO_GREEKS=false

# ──────────────────────────────────────────────
# Alerts
# ──────────────────────────────────────────────
SENDGRID_API_KEY=
ALERT_EMAIL=
LOG_LEVEL=INFO
