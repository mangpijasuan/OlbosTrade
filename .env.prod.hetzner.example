# ═══════════════════════════════════════════════════════════════════
# OlbosQuant — Production Environment Variables (Hetzner VPS + IBKR)
#
# SETUP:
#   1. Copy this file: cp .env.prod.hetzner.example .env.prod
#   2. Fill in every value marked [REQUIRED]
#   3. Never commit .env.prod to git
# ═══════════════════════════════════════════════════════════════════

# ── Broker (IBKR — IB Gateway runs in Docker alongside backend) ──
BROKER=ibkr
IBKR_USERNAME=                     # [REQUIRED] your IBKR paper trading username
IBKR_PASSWORD=                     # [REQUIRED] your IBKR paper trading password
IBKR_TRADING_MODE=paper            # paper or live
IBKR_CLIENT_ID=1
# IBKR_HOST and IBKR_PORT are set automatically in docker-compose.hetzner.yml

# ── VNC (to view IB Gateway GUI via SSH tunnel) ───────────────────
VNC_PASSWORD=                      # [REQUIRED] set a strong password

# ── Database (self-hosted PostgreSQL on this VPS) ─────────────────
POSTGRES_USER=options_user
POSTGRES_PASSWORD=                 # [REQUIRED] generate: openssl rand -hex 24
POSTGRES_DB=options_db
# DATABASE_URL is set automatically in docker-compose.hetzner.yml

# ── Trading Rules ─────────────────────────────────────────────────
STARTING_CAPITAL=25000
MAX_DAILY_LOSS_PCT=0.02
MAX_WEEKLY_LOSS_PCT=0.05
MAX_MONTHLY_LOSS_PCT=0.10
MAX_CONCURRENT_POSITIONS=5
MAX_TRADES_PER_DAY=3
MAX_CONSECUTIVE_LOSSES=3
COOLING_OFF_HOURS=24
CAPITAL_PRESERVATION_THRESHOLD=0.85
MAX_EQUITY_POSITIONS=5
MAX_OPTIONS_POSITIONS=5

# ── Equity signal settings ────────────────────────────────────────
EQUITY_WATCHLIST=AAPL,NVDA,MSFT,META,AMZN,GOOGL,AMD,TSLA,SPY,QQQ
EQUITY_SIGNAL_INTERVAL_MINUTES=15
EQUITY_MIN_CONFIDENCE=0.62
EQUITY_MIN_RISK_REWARD=1.80
EARNINGS_GATE_DAYS=3

# ── AI Signal Scorer ──────────────────────────────────────────────
SIGNAL_SCORE_THRESHOLD=0.65
SIGNAL_SCORE_PRESERVATION_MODE=0.80
MODEL_PATH=/app/ml/model_registry/signal_scorer_v1.pkl
RETRAIN_SCHEDULE=monthly

# ── Alerts (SendGrid) ────────────────────────────────────────────
SENDGRID_API_KEY=                  # optional — for trade alert emails
ALERT_EMAIL=                       # optional

# ── Security ──────────────────────────────────────────────────────
SECRET_KEY=                        # [REQUIRED] generate: openssl rand -hex 32
LOG_LEVEL=INFO
