# Copy to /opt/olbosquant/.env.hetzner on the Hetzner server.
# Never commit real credentials.

# ── Public app / image settings ───────────────────────────────────────────────
DOMAIN=trade.example.com
CERTBOT_EMAIL=you@example.com
GHCR_IMAGE_PREFIX=ghcr.io/YOUR_GITHUB_OWNER/YOUR_REPO
IMAGE_TAG=latest

# Required if the repo/package is private. GitHub Actions can update these.
GHCR_USERNAME=
GHCR_TOKEN=

# ── IBKR Gateway running on the Hetzner server ────────────────────────────────
BROKER=ibkr
IBKR_USERNAME=
IBKR_PASSWORD=
IBKR_TRADING_MODE=paper
# 4002 = IB Gateway paper, 4001 = IB Gateway live. Start with paper.
IBKR_PORT=4002
IBKR_CLIENT_ID=10
VNC_PASSWORD=

# ── Database / Redis ─────────────────────────────────────────────────────────
POSTGRES_USER=options_user
POSTGRES_PASSWORD=
POSTGRES_DB=options_db

# ── Admin API protection ─────────────────────────────────────────────────────
# Generate separate values:
#   openssl rand -hex 32
SECRET_KEY=
KILL_SWITCH_RESET_CODE=
# Optional: embeds the admin key into the frontend bundle so UI mutation buttons
# can call protected endpoints. Only use when the app is restricted to trusted
# operators (VPN/basic auth/private DNS).
VITE_ADMIN_API_KEY=

# ── Trading Rules ────────────────────────────────────────────────────────────
STARTING_CAPITAL=25000
MAX_DAILY_LOSS_PCT=0.02
MAX_WEEKLY_LOSS_PCT=0.05
MAX_MONTHLY_LOSS_PCT=0.10
MAX_CONCURRENT_POSITIONS=5
MAX_TRADES_PER_DAY=3
MAX_CONSECUTIVE_LOSSES=3
COOLING_OFF_HOURS=24
CAPITAL_PRESERVATION_THRESHOLD=0.85
MAX_EQUITY_POSITIONS=5
MAX_OPTIONS_POSITIONS=5

# ── Equity signal settings ──────────────────────────────────────────────────
EQUITY_WATCHLIST=AAPL,NVDA,MSFT,META,AMZN,GOOGL,AMD,TSLA,SPY,QQQ,JPM,V,MA
EQUITY_SIGNAL_INTERVAL_MINUTES=15
EQUITY_MIN_CONFIDENCE=0.62
EQUITY_MIN_CONFIDENCE_PAPER=0.45
EQUITY_MIN_RISK_REWARD=1.80
EARNINGS_GATE_DAYS=3

# ── ML / options flow ────────────────────────────────────────────────────────
SIGNAL_SCORE_THRESHOLD=0.65
SIGNAL_SCORE_PRESERVATION_MODE=0.80
MODEL_PATH=/app/ml/model_registry/signal_scorer_v1.pkl
RETRAIN_SCHEDULE=monthly
OPTIONS_FLOW_ENABLED=false
OPTIONS_FLOW_DEMO_MODE=false
OPTIONS_FLOW_WATCHLIST=SPY,QQQ,IWM,AAPL,TSLA,NVDA
OPTIONS_FLOW_MAX_DTE=60
OPTIONS_FLOW_MAX_CONTRACTS=40
OPTIONS_FLOW_SWEEP_WINDOW_MS=500
OPTIONS_FLOW_BLOCK_MIN_SIZE=500
OPTIONS_FLOW_LARGE_SWEEP_PREMIUM=500000
OPTIONS_FLOW_CHANNEL=options_flow_live
OPTIONS_FLOW_RETENTION_DAYS=90
OPTIONS_FLOW_ARCHIVE_DIR=/data/archive

# ── Alerts ──────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=
ALERT_EMAIL=
LOG_LEVEL=INFO
