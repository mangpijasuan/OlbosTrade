# ═══════════════════════════════════════════════════════════════════
# OlbosQuant — Hetzner VPS Environment
#
# SETUP:
#   1. cp .env.hetzner.example .env.hetzner
#   2. Fill in every [REQUIRED] value
#   3. scp .env.hetzner deploy@YOUR_SERVER:/opt/olbosquant/
#   4. Never commit .env.hetzner to git
# ═══════════════════════════════════════════════════════════════════

# ── IBKR Gateway (ib-gateway container) ───────────────────────────
# [REQUIRED] Paper trading credentials — used by headless IB Gateway
IBKR_USERNAME=
IBKR_PASSWORD=
IBKR_TRADING_MODE=paper

# Socket client id — must be unique if multiple API clients connect
IBKR_CLIENT_ID=10

# VNC password for 2FA login via SSH tunnel (port 5900)
VNC_PASSWORD=localdev

# Optional: daily IB Gateway auto-restart time (HH:MM AM/PM ET) — e.g. "11:59 PM"
# IB_GATEWAY_AUTO_RESTART_TIME=

# ── PostgreSQL (bundled container) ─────────────────────────────────
POSTGRES_USER=options_user
POSTGRES_PASSWORD=                        # [REQUIRED] strong random password
POSTGRES_DB=options_db

# ── Trading rules ──────────────────────────────────────────────────
STARTING_CAPITAL=25000
MAX_DAILY_LOSS_PCT=0.02
MAX_WEEKLY_LOSS_PCT=0.05
MAX_MONTHLY_LOSS_PCT=0.10
MAX_CONCURRENT_POSITIONS=5
MAX_TRADES_PER_DAY=6
MAX_CONSECUTIVE_LOSSES=3
COOLING_OFF_HOURS=24
CAPITAL_PRESERVATION_THRESHOLD=0.85

# ── AI signal scorer ───────────────────────────────────────────────
SIGNAL_SCORE_THRESHOLD=0.65
SIGNAL_SCORE_PRESERVATION_MODE=0.80
MODEL_PATH=/app/ml/model_registry/signal_scorer_v1.pkl
RETRAIN_SCHEDULE=monthly

# ── Options flow (off by default on VPS) ───────────────────────────
OPTIONS_FLOW_ENABLED=false
OPTIONS_FLOW_DEMO_MODE=false

# ── Alerts (optional) ──────────────────────────────────────────────
SENDGRID_API_KEY=
ALERT_EMAIL=

# ── App ────────────────────────────────────────────────────────────
SECRET_KEY=                               # [REQUIRED] openssl rand -hex 32
LOG_LEVEL=INFO
